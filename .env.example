# Copy this file to .env and fill in your own values.
# Never commit the real .env file or API key.
TRAVEL_AGENT_MODEL_MODE=openai_compatible
TRAVEL_AGENT_MODEL_NAME=your-model-name
TRAVEL_AGENT_API_KEY=your-api-key
TRAVEL_AGENT_BASE_URL=https://api.example.com/v1
TRAVEL_AGENT_HOTEL_PROVIDER=sqlite
TRAVEL_AGENT_TRANSPORT_PROVIDER=sqlite
TRAVEL_AGENT_ATTRACTION_PROVIDER=sqlite
TRAVEL_AGENT_FLYAI_COMMAND=flyai
TRAVEL_AGENT_FLYAI_TIMEOUT_SECONDS=30
# FlyAI rate-limit retry: attempts, backoff base, and concurrency gate (0 = off).
TRAVEL_AGENT_FLYAI_MAX_ATTEMPTS=3
TRAVEL_AGENT_FLYAI_BACKOFF_SECONDS=0.5
TRAVEL_AGENT_FLYAI_CONCURRENCY=2
# Agent model context window (estimated with 4 characters per token).
TRAVEL_AGENT_CONTEXT_MAX_MESSAGES=12
TRAVEL_AGENT_CONTEXT_MAX_TOKENS=4000
# Tool governance: per-turn tool call budget and LangGraph step limit.
TRAVEL_AGENT_MAX_TOOL_CALLS=30
TRAVEL_AGENT_MAX_AGENT_STEPS=25
# Booking amount consistency: relative tolerance vs the version's frozen
# budget.total (0.05 = 5%). Set TRAVEL_AGENT_BOOKING_AMOUNT_STRICT=1 to
# reject over-tolerance bookings instead of only recording the difference.
TRAVEL_AGENT_BOOKING_AMOUNT_TOLERANCE=0.05
TRAVEL_AGENT_BOOKING_AMOUNT_STRICT=0
# Wall-clock budget for one model turn (0 = disabled) and log verbosity
# (debug | info | warning | error).
TRAVEL_AGENT_TURN_TIMEOUT_SECONDS=300
TRAVEL_AGENT_LOG_LEVEL=warning
